---
layout: "base.njk"
---
<div class="blog_list">
{{ content | safe }}

<h4 class="rssLinkHeader">
  <a href="https://gay.mae.lol/blog/feed.xml" class="rssLinkBar">
    <img src="/assets/images/rss.png" class="rssLinkImage">
      <span class="rssLinkText">rss feed</span>
  </a>
</h4>

{%- for post in collections.post | reverse -%}

<hr>

<h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
<h4>{{ post.date | cute_date }}</h4>
 
{{ post.data.description | renderContent("md") | safe }}

{%- endfor -%}

</div>