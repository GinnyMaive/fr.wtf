{
  "name": "gintoxicat_ing",
  "version": "2.0.0",
  "main": ".eleventy.js",
  "scripts": {
      "start": "eleventy --serve",
      "serve": "eleventy --serve",
      "build": "eleventy",
      "diff": "TMP_DIR=$(mktemp -d /tmp/site.XXXXXX); eleventy --output $TMP_DIR >/dev/null; echo diffing $TMP_DIR and _site: ; diff -r _site $TMP_DIR"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-directory-output": "^1.0.2",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-for-inline": "^2.0.1"
  }
}
